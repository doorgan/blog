---
import ChapterNavigation from "../components/ChapterNavigation.astro";
import Giscus from "../components/Giscus.astro";
import LcdStrip from "../components/LcdStrip.astro";
import TableOfContents from "../components/TableOfContents.astro";
import DisplayTag from "../components/ui/DisplayTag.astro";
import Panel from "../components/ui/Panel.astro";
import { getTagUrl } from "../lib/tags";
import Layout from "./Layout.astro";

interface Chapter {
  slug: string;
  title: string;
  chapter: number;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime: number;
  wordCount: number;
  image?: string;
  series?: string;
  chapter?: number;
  seriesChapters?: Chapter[];
  editPath: string;
}

const {
  title,
  description,
  date,
  tags,
  headings,
  readingTime,
  wordCount,
  image,
  series,
  chapter,
  seriesChapters = [],
  editPath,
} = Astro.props;

const hasChapters = series && chapter && seriesChapters.length > 1;
---

<Layout
  title={((series && series + ": ") || "") + title}
  description={description}
  image={image}
  article={{ publishedAt: date, tags }}
>
  <LcdStrip
    title={title}
    readout={date.toISOString().slice(2, 10).replaceAll("-", ".")}
    stats={[
      `${readingTime} min read`,
      `${wordCount.toLocaleString("en-US")} words`,
    ]}
  >
    <div class="readout">
      {tags.map((tag) => <DisplayTag href={getTagUrl(tag)} text={tag} />)}
    </div>
  </LcdStrip>

  <main id="content" class="rack page-body" tabindex="-1">
    <aside class="rack-left contents">
      <TableOfContents headings={headings} />
    </aside>

    <article class="article">
      {
        hasChapters && (
          <ChapterNavigation
            series={series}
            currentChapter={chapter}
            chapters={seriesChapters}
          />
        )
      }

      <Panel
        footer={{
          note: "Spotted a mistake?",
          label: "Edit on GitHub",
          href: `https://github.com/doorgan/blog/edit/master/${editPath}`,
        }}
      >
        <div class="prose"><slot /></div>
      </Panel>

      {
        hasChapters && (
          <ChapterNavigation
            series={series}
            currentChapter={chapter}
            chapters={seriesChapters}
          />
        )
      }

      <Giscus />
    </article>
  </main>
</Layout>

<style>
  .readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 0.75rem;
    max-width: 100%;
    padding-block: 0.25rem;
  }

  .contents {
    position: sticky;
    top: calc(var(--nav-height) + 1rem);
    z-index: 40;
    max-height: calc(100vh - var(--nav-height) - 2rem);
    overflow-y: auto;
  }

  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--unit);
  }

  /* On small screens the contents bar docks under the top strip, edge to edge. */
  @media (max-width: 64rem) {
    .contents {
      top: var(--nav-height);
      max-height: none;
      margin-inline: -1rem;
      overflow: visible;
    }
  }
</style>
