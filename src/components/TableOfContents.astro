---
import Library from "./ui/Library.astro";
import Panel from "./ui/Panel.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings = [] } = Astro.props as { headings: Heading[] };

const entries = [
  ...headings
    .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
    .map((heading) => ({ id: heading.slug, title: heading.text })),
  { id: "comments", title: "Comments" },
];

const items = entries.map(({ id, title }, index) => ({
  number: String(index + 1).padStart(2, "0"),
  title,
  href: `#${id}`,
  target: id,
}));
---

<div class="toc-desktop">
  <Panel label="Contents" flush>
    <span slot="meta" data-progress-value>0%</span>
    <div class="level"><div data-progress-bar></div></div>
    <Library items={items} />
  </Panel>
</div>

<details class="toc-mobile">
  <summary>
    <span class="label">Contents</span>
    <span class="toc-current" data-toc-current>{items[0].title}</span>
    <span class="label toc-percent" data-progress-value>0%</span>
    <div class="level level--docked"><div data-progress-bar></div></div>
  </summary>
  <Library items={items} />
</details>

<style>
  .level {
    height: 3px;
    background: var(--face-sunk);
  }

  [data-progress-bar] {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .toc-mobile {
    display: none;
  }

  @media (max-width: 64rem) {
    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
      background: var(--face);
      border-bottom: 1px solid var(--line);
    }

    summary {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 1rem;
      cursor: pointer;
    }

    .toc-current {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      font-size: 0.8125rem;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .level--docked {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
    }

    details[open] summary {
      border-bottom: 1px solid var(--line);
    }

    .toc-percent {
      color: var(--ink-soft);
    }

    details :global(.library) {
      max-height: 50vh;
      overflow-y: auto;
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLElement>("[data-toc-item]")];
  const current = document.querySelector("[data-toc-current]");

  function activate(id: string) {
    for (const link of links) {
      if (link.dataset.tocItem === id) {
        link.setAttribute("aria-current", "true");
        if (current) current.textContent = link.dataset.title ?? "";
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  const headings = [...new Set(links.map((link) => link.dataset.tocItem))]
    .map((id) => document.getElementById(id ?? ""))
    .filter((heading) => heading !== null);

  const article = document.querySelector(".prose");
  const values = document.querySelectorAll("[data-progress-value]");
  const bars = document.querySelectorAll<HTMLElement>("[data-progress-bar]");

  let frame = 0;

  function update() {
    frame = 0;
    const readingLine = innerHeight * 0.3;
    const passed = headings.filter(
      (heading) => heading.getBoundingClientRect().top <= readingLine,
    );
    const heading = passed.at(-1) ?? headings[0];
    if (heading) activate(heading.id);

    if (!article) return;
    const { top, height } = article.getBoundingClientRect();
    const read = Math.min(1, Math.max(0, -top / Math.max(1, height - innerHeight)));
    values.forEach((value) => {
      value.textContent = `${Math.round(read * 100)}%`;
    });
    bars.forEach((bar) => {
      bar.style.transform = `scaleX(${read})`;
    });
  }

  addEventListener(
    "scroll",
    () => {
      frame ||= requestAnimationFrame(update);
    },
    { passive: true },
  );
  addEventListener("resize", update);
  update();
</script>
