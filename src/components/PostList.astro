---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/dates";
import { getPostUrl } from "../lib/posts";
import { getTagUrl } from "../lib/tags";
import Panel from "./ui/Panel.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
  label?: string;
}

const { posts, label = "Post library" } = Astro.props;
const count = `${String(posts.length).padStart(2, "0")} posts`;
---

<Panel label={label} meta={count} flush>
  <ol class="posts">
    {
      posts.map((post, index) => (
        <li class="post">
          <span class="post-number">{String(index + 1).padStart(2, "0")}</span>
          <div class="post-body">
            <h2>
              <a href={getPostUrl(post)}>
                {post.data.series && `${post.data.series}: `}
                {post.data.title}
              </a>
            </h2>
            <p class="post-meta">
              <span class="label">{formatDate(post.data.date)}</span>
              {post.data.tags.slice(0, 3).map((tag) => (
                <a class="label post-tag" href={getTagUrl(tag)}>
                  {tag}
                </a>
              ))}
            </p>
            {post.data.description && (
              <p class="post-description">{post.data.description}</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Panel>

<style>
  .posts {
    padding: 0;
    list-style: none;
  }

  .post {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
  }

  .post + .post {
    border-top: 1px solid var(--line);
  }

  .post:hover {
    background: var(--face-sunk);
  }

  .post-number {
    display: grid;
    place-items: center;
    color: var(--ink-soft);
    border-right: 1px solid var(--line);
    font-size: 0.875rem;
  }

  .post:hover .post-number {
    color: var(--on-accent);
    background: var(--accent);
  }

  .post-body {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
  }

  h2 {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h2 a {
    text-decoration: none;
  }

  /* The whole row is the link; tags stay clickable above it. */
  h2 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--ink-soft);
  }

  .post-tag {
    position: relative;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .post-tag:hover {
    text-decoration: underline;
  }

  .post-description {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }
</style>
