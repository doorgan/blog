---
import Segments from "./ui/Segments.astro";

interface Props {
  title: string;
  subtitle?: string;
  /** Real data for this page, in display characters. See parseReadout. */
  readout?: string;
  /** Short facts printed under the readout, joined with slashes. */
  stats?: string[];
}

const { title, subtitle, readout, stats = [] } = Astro.props;
---

<header class="lcd">
  <div class="rack">
    <div class="lcd-panel">
      <div class="lcd-title">
        <h1>{title}</h1>
        {subtitle && <p class="label">{subtitle}</p>}
        <slot />
      </div>

      {
        readout && (
          <div class="lcd-readout">
            <Segments text={readout} />
            {stats.length > 0 && <p class="label">{stats.join(" / ")}</p>}
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  .lcd {
    padding-top: calc(var(--nav-height) + 1.75rem);
    padding-bottom: 1.75rem;
    color: var(--display-ink);
    background-color: var(--display);
    background-image: radial-gradient(#15151d 1px, transparent 1.25px);
    background-size: 7px 7px;
    border-bottom: 1px solid var(--line);
  }

  .lcd-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem 2.5rem;
    align-items: start;
  }

  .lcd-title {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    min-width: 0;
  }

  h1 {
    color: var(--phosphor);
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .label {
    color: var(--display-soft);
  }

  .lcd-readout {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  @media (max-width: 40rem) {
    .lcd-panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .lcd-readout {
      justify-items: start;
    }
  }
</style>
