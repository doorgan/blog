---
interface Props {
  note: string;
}

const { note } = Astro.props;
---

<style>
  .annotation-mark {
    background: color-mix(in srgb, var(--accent-ink) 12%, transparent);
    border-bottom: 1px solid var(--accent-ink);
    cursor: pointer;
  }

  /* The number is the real button: a button can't wrap across lines like text. */
  .annotation-ref {
    margin-left: 0.2em;
    padding: 0;
    color: var(--accent-ink);
    background: none;
    border: 0;
    counter-increment: annotation;
    cursor: pointer;
    font: inherit;
    font-size: 0.65em;
    font-weight: 800;
    line-height: 1;
    vertical-align: 0.5em;
  }

  .annotation-ref::before {
    content: counter(annotation, decimal-leading-zero);
  }

  .annotation-note {
    padding: 0.5rem 0.75rem;
    background: var(--face);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .annotation-note::before {
    display: block;
    color: var(--accent-ink);
    content: counter(annotation, decimal-leading-zero);
    font-weight: 800;
  }

  /* Wide screens: the note hangs in the right rack column, level with its text. */
  @media (min-width: 80.01rem) {
    .annotation-note {
      position: absolute;
      left: calc(100% + var(--unit) + clamp(1.25rem, 4vw, 2.5rem));
      width: 15rem;
      color: var(--ink);
    }
  }

  /* Narrow screens: there's no side column, so the note opens under its text. */
  @media (max-width: 80rem) {
    .annotation-note {
      position: absolute;
      left: 0;
      right: 0;
      z-index: 10;
      display: none;
      color: var(--ink);
      box-shadow: 4px 4px 0 var(--line);
    }

    .annotation.is-open .annotation-note {
      display: block;
    }
  }

  @media print {
    .annotation-note {
      display: none;
    }
  }
</style>

<script>
  import { mountAnnotations } from "../../lib/annotations";

  mountAnnotations();
</script>

{/* Keep this last and tight: whitespace would show up in the sentence. */}
<span class="annotation"
  ><span class="annotation-mark"><slot /></span>&#8288;<button
    class="annotation-ref"
    type="button"
    aria-label="Toggle note"
    aria-expanded="false"></button><span class="annotation-note" role="note"
    >{note}</span
  ></span
>
