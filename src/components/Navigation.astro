---
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
---

<nav class="strip" aria-label="Site">
  <div class="rack">
    <div class="strip-inner">
      <a href="/" class="brand">Dorgan</a>
      <div class="ports">
      <a href="/posts" class="port port--cream" aria-current={current("/posts")}
        >Posts</a
      >
      <a href="/tags" class="port port--accent" aria-current={current("/tags")}
        >Tags</a
      >
      <div class="port-group">
        <a href="/about" class="port" aria-current={current("/about")}>About</a>
        <button
          id="theme-toggle"
          class="port switch"
          type="button"
          aria-label="Toggle theme"
        >
          <span class="switch-marks" aria-hidden="true">
            <span class="mark-on">I</span>
            <span class="mark-off">O</span>
          </span>
          Theme
        </button>
      </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .strip {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: var(--nav-height);
    background: var(--strip);
  }

  .rack,
  .strip-inner,
  .ports {
    height: 100%;
  }

  .strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .brand {
    color: var(--ink);
    font-size: 1.125rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ports {
    display: flex;
    gap: clamp(0.375rem, 1.5vw, 1rem);
  }

  .port-group {
    display: flex;
    color: #e5e6e6;
    background: #1c1d1e;
    box-shadow: 2px 0 4px rgb(0 0 0 / 0.16);
  }

  .port {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(3.5rem, 11vw, 5.5rem);
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 23rem) {
    .port {
      min-width: 3.125rem;
    }
  }

  .port--cream,
  .port--accent {
    box-shadow: 2px 0 4px rgb(0 0 0 / 0.16);
  }

  .port--cream {
    color: #2a2a2a;
    background: #f4f3ef;
  }

  .port--accent {
    color: var(--on-accent);
    background: var(--accent);
  }

  .port:hover {
    filter: brightness(1.15);
  }

  /* A printed tick marks the page you're on, like the marks on the real ports. */
  .port[aria-current]::before {
    position: absolute;
    top: 0.1875rem;
    left: 50%;
    width: 1px;
    height: 0.3125rem;
    background: currentColor;
    content: "";
  }

  .switch-marks {
    position: absolute;
    top: 0.125rem;
    left: 50%;
    display: flex;
    gap: 0.75rem;
    font-size: 0.5rem;
    line-height: 1;
    transform: translateX(-50%);
  }

  .mark-off,
  :global(.dark) .mark-on {
    opacity: 0.4;
  }

  :global(.dark) .mark-off {
    opacity: 1;
  }
</style>

<script>
  const themeToggle = document.getElementById("theme-toggle");

  function applyTheme(theme: "dark" | "light") {
    const isDark = theme === "dark";
    document.documentElement.classList.toggle("dark", isDark);
    document.documentElement.dataset.theme = theme;

    try {
      localStorage.setItem("theme", theme);
    } catch (error) {}

    window.dispatchEvent(
      new CustomEvent("blog:theme-change", { detail: { theme } }),
    );
  }

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    applyTheme(isDark ? "light" : "dark");
  });
</script>
