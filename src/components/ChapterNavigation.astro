---
import Library from "./ui/Library.astro";
import Panel from "./ui/Panel.astro";

interface Chapter {
  slug: string;
  title: string;
  chapter: number;
  url: string;
}

interface Props {
  series: string;
  currentChapter: number;
  chapters: Chapter[];
}

const { series, currentChapter, chapters } = Astro.props;
const pad = (value: number) => String(value).padStart(2, "0");

const items = chapters.map((chapter) => ({
  number: pad(chapter.chapter),
  title: chapter.title,
  href: chapter.url,
  active: chapter.chapter === currentChapter,
}));
---

<Panel
  label={series}
  meta={`Ch ${pad(currentChapter)} / ${pad(chapters.length)}`}
  flush
>
  <Library items={items} />
</Panel>
