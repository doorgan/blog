---
export interface LibraryItem {
  number: string;
  title: string;
  href: string;
  target?: string;
  active?: boolean;
}

interface Props {
  items: LibraryItem[];
}

const { items } = Astro.props;
---

<ol class="library">
  {
    items.map((item) => (
      <li>
        <a
          href={item.href}
          class="library-row"
          data-toc-item={item.target}
          data-title={item.title}
          aria-current={item.active ? "page" : undefined}
        >
          <span class="library-number">{item.number}</span>
          <span class="library-title">{item.title}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .library {
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  .library-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: stretch;
    min-height: 2.25rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .library-row:hover {
    background: var(--face-sunk);
  }

  .library-number {
    display: grid;
    place-items: center;
    border-right: 1px solid var(--line);
  }

  .library-title {
    align-self: center;
    padding: 0.375rem 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-row[aria-current] {
    color: var(--ink);
    font-weight: 700;
  }

  .library-row[aria-current] .library-number {
    color: var(--on-accent);
    background: var(--accent);
  }
</style>
