---
interface Props {
  label?: string;
  meta?: string | string[];
  id?: string;
  flush?: boolean;
  /** Cards stacked behind this one. Phones always show a single card. */
  stack?: number;
  /** A footer row mirroring the header: a note, then a link in its own cell. */
  footer?: { note: string; label: string; href: string };
}

const STEP = 4;

const { label, meta = [], id, flush = false, stack = 3, footer } = Astro.props;

const cells = [meta].flat();

const shadows = Array.from({ length: stack }, (_, index) => {
  const offset = (index + 1) * STEP;
  return [
    `${offset}px ${offset}px 0 0 var(--face-sunk)`,
    `${offset}px ${offset}px 0 1px var(--line)`,
  ];
}).flat();
---

<section
  class:list={["panel", { "panel--flush": flush }]}
  id={id}
  style={`--stack: ${shadows.join(", ")}; --depth: ${stack * STEP}px`}
>
  {
    label && (
      <header class="panel-head">
        <span class="label panel-title">{label}</span>
        {cells.map((cell) => (
          <span class="label panel-cell">{cell}</span>
        ))}
        {Astro.slots.has("meta") && (
          <span class="label panel-cell">
            <slot name="meta" />
          </span>
        )}
      </header>
    )
  }
  <div class="panel-body"><slot /></div>
  {
    footer && (
      <footer class="panel-foot">
        <span class="label panel-note">{footer.note}</span>
        <a
          class="label panel-cell panel-link"
          href={footer.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {footer.label}
        </a>
      </footer>
    )
  }
</section>

<style>
  .panel {
    position: relative;
    background: var(--face);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: var(--stack);
    margin-right: var(--depth);
    margin-bottom: var(--depth);
  }

  .panel-head {
    display: flex;
    min-height: 2.25rem;
    border-bottom: 1px solid var(--line);
  }

  .panel-title {
    flex: 1;
    align-self: center;
    min-width: 0;
    padding: 0.375rem 0.875rem;
  }

  .panel-cell {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    color: var(--ink-soft);
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }

  .panel-body {
    padding: 1.75rem clamp(1.25rem, 4vw, 2.5rem);
  }

  .panel-foot {
    display: flex;
    min-height: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .panel-note {
    flex: 1;
    align-self: center;
    min-width: 0;
    padding: 0.375rem 0.875rem;
    color: var(--ink-soft);
    text-align: right;
  }

  .panel-link {
    color: var(--ink);
    text-decoration: none;
  }

  .panel-link:hover {
    color: var(--on-accent);
    background: var(--accent);
  }

  .panel--flush .panel-body {
    padding: 0;
  }

  @media (max-width: 48rem) {
    .panel {
      margin: 0;
      box-shadow: none;
    }
  }
</style>
