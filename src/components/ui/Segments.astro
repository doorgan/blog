---
import { parseReadout } from "../../lib/lcd";

interface Props {
  text: string;
  /** Total characters, including the unlit ones before the text. */
  size?: number;
}

const { text, size = 0 } = Astro.props;

const characters = parseReadout(text);
const blanks = Math.max(0, size - characters.length);
const cells = [
  ...Array.from({ length: blanks }, () => ({ segments: "", dot: false })),
  ...characters,
];

const SHAPES: Record<string, string> = {
  a: "3,1 4,0 16,0 17,1 14,3 6,3",
  b: "18,2 19,3 19,17 17.5,19 16,17 16,5",
  c: "17.5,21 19,23 19,37 18,38 16,35 16,23",
  d: "6,37 14,37 17,39 16,40 4,40 3,39",
  e: "2,38 1,37 1,23 2.5,21 4,23 4,35",
  f: "1,3 2,2 4,5 4,17 2.5,19 1,17",
  g: "3.5,20 5,18.5 9,18.5 9.5,20 9,21.5 5,21.5",
  G: "16.5,20 15,18.5 11,18.5 10.5,20 11,21.5 15,21.5",
  h: "5,5 7,5 8.5,12 8.5,17 7,17 5,10",
  i: "9,5 10,4 11,5 11,17 10,18 9,17",
  j: "15,5 13,5 11.5,12 11.5,17 13,17 15,10",
  k: "5,35 7,35 8.5,28 8.5,23 7,23 5,30",
  l: "9,23 10,22 11,23 11,35 10,36 9,35",
  m: "15,35 13,35 11.5,28 11.5,23 13,23 15,30",
};
---

<svg
  class="segments"
  viewBox={`0 0 ${cells.length * 25} 40`}
  role="img"
  aria-label={text}
>
  {
    cells.map((cell, index) => (
      <g transform={`translate(${index * 25} 0)`} style={`--cell: ${index}`}>
        {Object.entries(SHAPES).map(([name, points]) => (
          <polygon
            class:list={["part", { on: cell.segments.includes(name) }]}
            points={points}
          />
        ))}
        <rect
          class:list={["part", { on: cell.dot }]}
          x="20.5"
          y="36.5"
          width="3.5"
          height="3.5"
        />
      </g>
    ))
  }
</svg>

<style>
  .segments {
    display: block;
    height: 3.25rem;
    width: auto;
    max-width: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 5px rgb(120 185 255 / 0.5));
  }

  .part {
    fill: var(--seg-off);
  }

  .part.on {
    fill: var(--seg-on);
  }

  /* On load every segment lights, then the unused ones drop away cell by cell. */
  .part:not(.on) {
    animation: settle 90ms steps(1, end) backwards;
    animation-delay: calc(200ms + var(--cell) * 90ms);
  }

  @keyframes settle {
    from {
      fill: var(--seg-on);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .part:not(.on) {
      animation: none;
    }
  }
</style>
