---
import Layout from "../layouts/Layout.astro";
import LcdStrip from "../components/LcdStrip.astro";
import Panel from "../components/ui/Panel.astro";
import { Content } from "./components.mdx";
---

<Layout title="Lab" noindex>
  <LcdStrip
    title="Lab"
    subtitle="Every part, one page. Dev server only."
    readout="8.8.8"
    stats={["Test", "Printed text"]}
  />
  <main class="rack page-body">
    <Panel>
      <div class="prose"><Content /></div>
    </Panel>
  </main>
</Layout>
