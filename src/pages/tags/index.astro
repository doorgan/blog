---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LcdStrip from '../../components/LcdStrip.astro';
import Led from '../../components/ui/Led.astro';
import Panel from '../../components/ui/Panel.astro';
import { getTagUrl } from '../../lib/tags';

const posts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Get all tags with their counts
const tagCounts = new Map<string, number>();
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title="Tags | Dorgan's Blog">
  <LcdStrip
    title="Tag bank"
    readout={String(sortedTags.length).padStart(2, "0")}
    stats={["Tags"]}
  />

  <main id="content" class="rack page-body" tabindex="-1">
    <Panel label="Tags" meta={`${sortedTags.length} assigned`}>
      <div class="pads">
        {
          sortedTags.map(([tag, count], index) => (
            <div class="pad-cell">
              <a class="key pad" href={getTagUrl(tag)}>
                <span class="pad-number">{index + 1}</span>
                <span>{tag}</span>
              </a>
              <span class="printed">
                <Led on />
                {count} {count === 1 ? "post" : "posts"}
              </span>
            </div>
          ))
        }
      </div>
    </Panel>
  </main>
</Layout>

<style>
  .pads {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 1.25rem 1rem;
  }

  .pad-cell {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }

  .pad {
    aspect-ratio: 1;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    overflow-wrap: anywhere;
  }

  .pad-number {
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: 0;
  }
</style>
