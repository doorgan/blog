---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import LcdStrip from "../../components/LcdStrip.astro";
import PostList from "../../components/PostList.astro";
import DisplayTag from "../../components/ui/DisplayTag.astro";
import { getTagRouteParam } from "../../lib/tags";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return allTags.map((tag) => ({
    params: { tag: getTagRouteParam(tag) },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`Posts tagged "${tag}" | Dorgan's Blog`}>
  <LcdStrip
    title={tag}
    readout={String(posts.length).padStart(2, "0")}
    stats={["Posts"]}
  >
    <DisplayTag href="/tags" text="All tags" />
  </LcdStrip>

  <main class="rack page-body">
    <PostList posts={posts} label="Tagged" />
  </main>
</Layout>
