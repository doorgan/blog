---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import LcdStrip from "../../components/LcdStrip.astro";
import PostList from "../../components/PostList.astro";
import { getTagRouteParam } from "../../lib/tags";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return allTags.map((tag) => ({
    params: { tag: getTagRouteParam(tag) },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`Posts tagged "${tag}" | Dorgan's Blog`}>
  <LcdStrip
    title={tag}
    subtitle={`${posts.length} ${posts.length === 1 ? "POST" : "POSTS"} LOADED`}
  >
    <div slot="kicker" class="flex items-center gap-3 mb-2">
      <a href="/tags" class="pad-btn text-xs">TAGS</a>
      <span class="text-[hsl(var(--muted-foreground))]">/</span>
      <span
        class="text-xs text-[hsl(var(--muted-foreground))] uppercase tracking-wider"
        >{tag}</span
      >
    </div>
  </LcdStrip>

  <div class="ep-row">
    <main class="w-full px-4 py-12">
      <!-- Posts -->
      <PostList posts={posts} showNumber={true} numberStart={1} />
    </main>
  </div>
</Layout>
