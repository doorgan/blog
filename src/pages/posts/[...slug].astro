---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import {
  getPostEditPath,
  getPostRouteParam,
  getPostUrl,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return posts.map((post) => ({
    params: { slug: getPostRouteParam(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Get all chapters in the same series if this post is part of a series
let seriesChapters: {
  slug: string;
  title: string;
  chapter: number;
  url: string;
}[] = [];
if (post.data.series) {
  const allPosts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  seriesChapters = allPosts
    .filter((p) => p.data.series === post.data.series)
    .sort((a, b) => (a.data.chapter || 0) - (b.data.chapter || 0))
    .map((p) => ({
      slug: p.id,
      title: p.data.title,
      chapter: p.data.chapter || 0,
      url: getPostUrl(p),
    }));
}
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  headings={headings}
  readingTime={readingTime}
  wordCount={wordCount}
  image={post.data.image}
  series={post.data.series}
  chapter={post.data.chapter}
  seriesChapters={seriesChapters}
  editPath={getPostEditPath(post)}
>
  <Content />
</PostLayout>
