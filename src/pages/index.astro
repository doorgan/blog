---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LcdStrip from "../components/LcdStrip.astro";
import PostList from "../components/PostList.astro";
import Key from "../components/ui/Key.astro";

const posts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentPosts = sortedPosts.slice(0, 15);
const hasMorePosts = sortedPosts.length > 15;
---

<Layout title="Dorgan's Blog">
  <LcdStrip
    title="Latest posts"
    readout={String(posts.length).padStart(2, "0")}
    stats={[
      "Posts",
      `${new Set(posts.flatMap((post) => post.data.tags)).size} tags`,
    ]}
  />

  <main class="rack page-body">
    <div class="stack">
      <PostList posts={recentPosts} label="Latest" />
      {hasMorePosts && <Key href="/posts">All posts</Key>}
    </div>
  </main>
</Layout>

<style>
  .stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--unit);
  }

  .stack > :global(section) {
    width: 100%;
  }
</style>
