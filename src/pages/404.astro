---
import LcdStrip from "../components/LcdStrip.astro";
import Key from "../components/ui/Key.astro";
import Panel from "../components/ui/Panel.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not all who wander are lost" noindex>
  <LcdStrip title="Page not found" readout="404" stats={["Error"]} />

  <main class="rack page-body">
    <Panel label="No sample loaded">
      <div class="prose">
        <p>The page you are looking for does not seem to exist.</p>
        <p>But thanks for dropping by.</p>
        <Key href="/" variant="accent">Return home</Key>
      </div>
    </Panel>
  </main>
</Layout>
