---
import Layout from '../layouts/Layout.astro';
import LcdStrip from '../components/LcdStrip.astro';
---

<Layout title="Not all who wander are lost" noindex>
  <LcdStrip title="404" subtitle="PAGE NOT FOUND" />

  <div class="ep-row">
    <main class="w-full px-4 py-12">
      <div class="card-grid flow">
        <h1 class="text-2xl font-bold uppercase tracking-wider">Not all who wander are lost</h1>
        <p>The page you are looking for does not seem to exist.</p>
        <p>But thanks for dropping by.</p>
        <a href="/" class="pad-btn mt-4">Return home</a>
      </div>
    </main>
  </div>
</Layout>
